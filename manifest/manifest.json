{
  "kind": "api_package",
  "name": "alpaca",
  "version": "1.4.1",
  "display_name": "Alpaca Trading",
  "description": "Alpaca brokerage API — paper/live trading: portfolio, orders, watchlist, one-shot price triggers.",
  "keywords": [
    "alpaca",
    "trading",
    "brokerage",
    "portfolio",
    "orders"
  ],
  "author": "Kestrel",
  "license": "MIT",
  "homepage": "https://github.com/railstracks/animus-package-alpaca",
  "state_schema": {
    "key_id": {
      "type": "string",
      "secret": true
    },
    "secret_key": {
      "type": "string",
      "secret": true
    },
    "paper": {
      "type": "boolean",
      "default": true
    },
    "watchlist": {
      "type": "string",
      "default": "[]"
    },
    "base_url": {
      "type": "string",
      "default": "https://paper-api.alpaca.markets"
    },
    "triggers": {
      "type": "string",
      "default": "[]"
    },
    "watchlist_symbols": {
      "type": "string",
      "default": "BTC/USD"
    },
    "stock_symbols": {
      "type": "string",
      "description": "comma-separated stock symbols for the stocks poller connection (plain symbols, no slash)",
      "default": "AAPL,MSFT"
    }
  },
  "commands": [
    {
      "name": "account get",
      "kind": "action",
      "description": "Account summary: equity, cash, buying power, P&L.",
      "script_file": "scripts/account_get.lua"
    },
    {
      "name": "positions list",
      "kind": "action",
      "description": "Open positions with current price, market value, unrealized P&L.",
      "script_file": "scripts/positions_list.lua"
    },
    {
      "name": "position close",
      "kind": "action",
      "description": "Close an open position by symbol via market order (BTC/USD or BTCUSD both accepted). Optional qty closes partially; omit for full close.",
      "parameters": {
        "symbol": {
          "type": "string",
          "required": true
        },
        "qty": {
          "type": "string",
          "required": false
        }
      },
      "script_file": "scripts/position_close.lua"
    },
    {
      "name": "orders list",
      "kind": "action",
      "description": "Recent orders (default open; all=true for history).",
      "parameters": {
        "all": {
          "type": "boolean",
          "required": false
        },
        "limit": {
          "type": "integer",
          "required": false
        }
      },
      "script_file": "scripts/orders_list.lua"
    },
    {
      "name": "order get",
      "kind": "action",
      "description": "Fetch a single order by id with full detail: status, fills, timestamps. Works for open, filled and cancelled orders.",
      "parameters": {
        "order_id": {
          "type": "string",
          "required": true
        }
      },
      "script_file": "scripts/order_get.lua"
    },
    {
      "name": "order place",
      "kind": "action",
      "description": "Submit an order. Side buy|sell; qty in shares OR notional in dollars (exactly one; crypto notional minimum is $10); time_in_force day|gtc|ioc|fok (crypto defaults gtc).",
      "parameters": {
        "symbol": {
          "type": "string",
          "required": true
        },
        "qty": {
          "type": "string",
          "required": false
        },
        "side": {
          "type": "string",
          "required": true
        },
        "type": {
          "type": "string",
          "required": false
        },
        "time_in_force": {
          "type": "string",
          "required": false
        },
        "limit_price": {
          "type": "string",
          "required": false
        },
        "stop_price": {
          "type": "string",
          "required": false
        },
        "client_order_id": {
          "type": "string",
          "required": false
        },
        "notional": {
          "type": "string",
          "required": false
        }
      },
      "script_file": "scripts/order_place.lua"
    },
    {
      "name": "order cancel",
      "kind": "action",
      "description": "Cancel an open order by id.",
      "parameters": {
        "order_id": {
          "type": "string",
          "required": true
        }
      },
      "script_file": "scripts/order_cancel.lua"
    },
    {
      "name": "order replace",
      "kind": "action",
      "description": "Replace quantity/limit/stop/time_in_force of an open order.",
      "parameters": {
        "order_id": {
          "type": "string",
          "required": true
        },
        "qty": {
          "type": "string",
          "required": false
        },
        "limit_price": {
          "type": "string",
          "required": false
        },
        "stop_price": {
          "type": "string",
          "required": false
        },
        "time_in_force": {
          "type": "string",
          "required": false
        }
      },
      "script_file": "scripts/order_replace.lua"
    },
    {
      "name": "assets list",
      "kind": "action",
      "description": "List assets with filters. Server-side: status (active|inactive|all, default active), class (us_equity|crypto), exchange (NASDAQ|NYSE|ARCA|BATS|AMEX|OTC). Client-side: search (case-insensitive substring on symbol or name), limit (default 20, max 100), offset. Returns total + page. Use search for symbol discovery.",
      "parameters": {
        "search": {
          "type": "string",
          "required": false
        },
        "status": {
          "type": "string",
          "required": false
        },
        "class": {
          "type": "string",
          "required": false
        },
        "exchange": {
          "type": "string",
          "required": false
        },
        "limit": {
          "type": "string",
          "required": false
        },
        "offset": {
          "type": "string",
          "required": false
        }
      },
      "script_file": "scripts/assets_list.lua"
    },
    {
      "name": "asset get",
      "kind": "action",
      "description": "Asset info: tradability, marginability, shortability, price precision.",
      "parameters": {
        "symbol": {
          "type": "string",
          "required": true
        }
      },
      "script_file": "scripts/asset_get.lua"
    },
    {
      "name": "clock get",
      "kind": "action",
      "description": "Market clock: is the market open, next open/close.",
      "script_file": "scripts/clock_get.lua"
    },
    {
      "name": "bars",
      "kind": "action",
      "description": "Historical OHLCV bars. Routes by symbol shape: BTC/USD-style -> crypto (v1beta3), plain -> stocks (feed iex on paper: ~20 days daily history on free tier). timeframe 1Min|5Min|15Min|1Hour|1Day (default 1Hour); limit default 100 max 1000 (per page); start/end RFC3339 or YYYY-MM-DD (default lookback: crypto 7d, stock 30d); page_token continues a truncated page. Multi-symbol queries page symbol-by-symbol (all of symbol 1, then symbol 2). One asset class per call.",
      "parameters": {
        "symbols": {
          "type": "string",
          "required": true
        },
        "timeframe": {
          "type": "string",
          "required": false
        },
        "start": {
          "type": "string",
          "required": false
        },
        "stop": {
          "type": "string",
          "required": false
        },
        "limit": {
          "type": "string",
          "required": false
        },
        "feed": {
          "type": "string",
          "required": false
        },
        "adjustment": {
          "type": "string",
          "required": false
        },
        "page_token": {
          "type": "string",
          "required": false
        }
      },
      "script_file": "scripts/bars.lua"
    },
    {
      "name": "latest bar",
      "kind": "action",
      "description": "Latest bar per symbol (routes crypto/stock by symbol shape). Crypto trades 24/7; stock latest uses feed iex on paper keys.",
      "parameters": {
        "symbols": {
          "type": "string",
          "required": true
        },
        "feed": {
          "type": "string",
          "required": false
        }
      },
      "script_file": "scripts/latest_bar.lua"
    },
    {
      "name": "latest quote",
      "kind": "action",
      "description": "Latest bid/ask quote per symbol (routes crypto/stock by symbol shape).",
      "parameters": {
        "symbols": {
          "type": "string",
          "required": true
        },
        "feed": {
          "type": "string",
          "required": false
        }
      },
      "script_file": "scripts/latest_quote.lua"
    },
    {
      "name": "latest trade",
      "kind": "action",
      "description": "Latest executed trade per symbol (routes crypto/stock by symbol shape).",
      "parameters": {
        "symbols": {
          "type": "string",
          "required": true
        },
        "feed": {
          "type": "string",
          "required": false
        }
      },
      "script_file": "scripts/latest_trade.lua"
    },
    {
      "name": "orderbook",
      "kind": "action",
      "description": "Crypto order book depth (bids/asks). Crypto-only. depth default 10 max 50.",
      "parameters": {
        "symbols": {
          "type": "string",
          "required": true
        },
        "depth": {
          "type": "string",
          "required": false
        }
      },
      "script_file": "scripts/orderbook.lua"
    },
    {
      "name": "news",
      "kind": "action",
      "description": "Stock market news articles. Optional symbols filter, start/end, sort asc|desc, limit default 10 max 50, page_token pagination.",
      "parameters": {
        "symbols": {
          "type": "string",
          "required": false
        },
        "start": {
          "type": "string",
          "required": false
        },
        "stop": {
          "type": "string",
          "required": false
        },
        "sort": {
          "type": "string",
          "required": false
        },
        "limit": {
          "type": "string",
          "required": false
        },
        "page_token": {
          "type": "string",
          "required": false
        }
      },
      "script_file": "scripts/news.lua"
    },
    {
      "name": "watchlist list",
      "kind": "action",
      "description": "Symbols currently tracked for trigger evaluation.",
      "script_file": "scripts/watchlist_list.lua"
    },
    {
      "name": "watchlist add",
      "kind": "action",
      "description": "Add a symbol to the tracked list.",
      "parameters": {
        "symbol": {
          "type": "string",
          "required": true
        }
      },
      "script_file": "scripts/watchlist_add.lua"
    },
    {
      "name": "watchlist remove",
      "kind": "action",
      "description": "Remove a symbol from the tracked list.",
      "parameters": {
        "symbol": {
          "type": "string",
          "required": true
        }
      },
      "script_file": "scripts/watchlist_remove.lua"
    },
    {
      "name": "trigger add",
      "kind": "action",
      "description": "Arm a one-shot price trigger: when symbol crosses above/below threshold, fire prompt to the owning agent (once). Returns current close for context. The prompt is the agent-facing text delivered when the trigger fires (required).",
      "parameters": {
        "symbol": {
          "type": "string",
          "required": true
        },
        "condition": {
          "type": "string",
          "required": true
        },
        "threshold": {
          "type": "string",
          "required": true
        },
        "prompt": {
          "type": "string",
          "required": true
        }
      },
      "script_file": "scripts/trigger_add.lua"
    },
    {
      "name": "trigger list",
      "kind": "action",
      "description": "Armed and recently-fired triggers.",
      "script_file": "scripts/trigger_list.lua"
    },
    {
      "name": "trigger remove",
      "kind": "action",
      "description": "Disarm a trigger. Pass trigger_id or id.",
      "parameters": {
        "trigger_id": {
          "type": "string",
          "required": false
        },
        "id": {
          "type": "string",
          "required": false
        }
      },
      "script_file": "scripts/trigger_remove.lua"
    },
    {
      "name": "on price update",
      "kind": "hook",
      "event": "on_message",
      "description": "Connection hook: evaluates fired triggers against latest prices; one-shot semantics.",
      "script_file": "scripts/on_price_update.lua"
    }
  ],
  "connections": [
    {
      "name": "crypto",
      "type": "longpoll",
      "url_template": "https://data.alpaca.markets/v1beta3/crypto/us/latest/bars",
      "headers_template": {
        "APCA-API-KEY-ID": "{{state.key_id}}",
        "APCA-API-SECRET-KEY": "{{state.secret_key}}"
      },
      "poll": {
        "cursor_path": "bars",
        "interval_s": 30,
        "params_template": {
          "symbols": "{{state.watchlist_symbols}}"
        }
      },
      "hooks": {
        "on_message": "on price update"
      }
    },
    {
      "name": "stocks",
      "type": "longpoll",
      "url_template": "https://data.alpaca.markets/v2/stocks/bars",
      "headers_template": {
        "APCA-API-KEY-ID": "{{state.key_id}}",
        "APCA-API-SECRET-KEY": "{{state.secret_key}}"
      },
      "poll": {
        "cursor_path": "next_page_token",
        "interval_s": 60,
        "params_template": {
          "symbols": "{{state.stock_symbols}}",
          "timeframe": "1Min",
          "limit": "1"
        }
      },
      "hooks": {
        "on_message": "on price update"
      }
    }
  ]
}